# .env.example — SAM Backend
# Copie este arquivo para .env e preencha os valores antes de rodar com Docker Compose.

# ===== Banco de Dados =====
MARIADB_ROOT_PASSWORD=rootpass
MARIADB_DATABASE=sam_db
MARIADB_USER=sam_user
MARIADB_PASSWORD=sam_pass

# ===== JWT =====
# IMPORTANTE: Substitua por uma chave aleatória de no mínimo 256 bits em produção!
# Gerador: openssl rand -base64 64
JWT_SECRET=troque_em_producao_por_uma_chave_forte_de_256bits_e_mantenha_segura

# Expiração do token em milissegundos (default: 86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000
